<%-include("includes/head.ejs")%>
<%-include("includes/navbar.ejs")%>
<%- include('includes/alert') %>
<h3 style="text-align: center; padding-top: 50px; color: maroon;">Welcome To ReFind</h3>
<div class="signin_form">
    <form action="/signin" method="post"                                class="needs-validation " novalidate>
        <div class="signin">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" class="form-control" id="username" name="username" required>
                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter your username.
                </div>
            </div>


            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required>
                <div class="valid-feedback">
                    Looks good!
                </div>
                <div class="invalid-feedback">
                    Please enter your eamil.
                </div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" name="password" required>
                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please enter your password.
                </div>
            </div>

            <button type="submit" class="btn btn-primary" class="mb-3">signIn</button>
        </div>
    </form>
</div>
<%- include("includes/frontValidate.ejs") %>